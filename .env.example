# Copy to .env and fill in. NEVER commit real secrets.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/egrant
DATABASE_USERNAME=egrant
DATABASE_PASSWORD=egrant

# --- Security ---
# Use a long random string (>= 32 bytes) in production.
JWT_SECRET=change-me-in-prod-this-is-a-very-long-development-only-secret-key-0123456789

# --- CORS (comma-separated origins, or * for dev) ---
CORS_ALLOWED_ORIGINS=*

# --- SMTP / mail ---
MAIL_ENABLED=false
MAIL_FROM=no-reply@e-grant.aztu.edu.az
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- File storage (avatars etc.) ---
STORAGE_BASE_DIR=./var/storage

# --- Profile ---
SPRING_PROFILES_ACTIVE=local
